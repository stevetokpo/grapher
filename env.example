# Clés API pour le chat IA (route /api/chat).
# Copie ce fichier en .env.local et renseigne tes clés, puis redémarre `npm run dev`.

# https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Clé partagée pour l'ingestion live (EA MT5 → /api/live/*).
# Optionnelle : vide/absente = routes ouvertes (usage local).
# Si définie, l'EA doit envoyer la même valeur (paramètre InpApiKey).
GRAPHER_INGEST_KEY=


# ─── Notifications (voir docs/notifications.md) ────────────────────────────
# Chaque canal est indépendant : un canal dont les variables manquent est
# simplement affiché « non configuré » dans le panneau Alertes, il ne casse rien.

# Coupe-circuit global. NOTIFY_ENABLED=false désarme TOUS les envois sans
# avoir à désactiver les alertes une par une.
NOTIFY_ENABLED=true

# Telegram — bot créé via @BotFather.
# chat_id : écris un message au bot, puis ouvre
#   https://api.telegram.org/bot<TOKEN>/getUpdates  → result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail — SMTP (nodemailer).
# SMTP_SECURE=true ⇒ TLS implicite (port 465). Sinon STARTTLS (587/25).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Web Push — génère la paire avec : npx web-push generate-vapid-keys
# La clé publique doit être présente DEUX fois : la version NEXT_PUBLIC_ est la
# seule que le navigateur peut lire (Next n'expose que ce préfixe au client).
VAPID_SUBJECT=mailto:toi@exemple.fr
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
