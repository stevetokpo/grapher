//@version=6
// =========================================================================
//  INDICATEUR : rFVG / aFVG — Fair Value Gaps de retournement
//
//  Portage fidèle de calcRFVG() (lib/patterns.js) de la plateforme Grapher,
//  augmenté du mode aFVG.
//
//  MOTIF DE BASE (commun aux deux) — imbalance 3 bougies dont la bougie
//  CENTRALE, celle qui creuse le gap, est directionnelle et large :
//
//    • baissier : bougie centrale BAISSIÈRE, et le plus bas de la bougie
//      précédente reste au-dessus du plus haut de la bougie suivante.
//        zone = [ plus_haut(suivante) ; plus_bas(précédente) ]
//
//    • haussier : bougie centrale HAUSSIÈRE, et le plus haut de la bougie
//      précédente reste sous le plus bas de la bougie suivante.
//        zone = [ plus_haut(précédente) ; plus_bas(suivante) ]
//
//    Taille : la bougie centrale doit mesurer >= x × ATR(14). L'ATR est lu
//    AVANT elle, sinon il contiendrait déjà la bougie à qualifier.
//
//  LES DEUX MODES se distinguent par une seule chose, la position de la
//  bougie centrale par rapport à la MM50 :
//
//    • rFVG (retournement) — la centrale va à CONTRE-COURANT de son côté de la
//      MM50, et ne la touche pas : baissière entièrement AU-DESSUS, ou
//      haussière entièrement EN DESSOUS.
//
//    • aFVG (toutes) — la position par rapport à la MM50 n'est pas regardée.
//      Tout motif de base compte, rFVG inclus : l'ensemble aFVG contient
//      l'ensemble rFVG. Chaque boîte est étiquetée selon ce qu'elle est
//      vraiment — « rFVG » si elle respecte aussi la MM, « aFVG » sinon.
//
//  Deux sens, et c'est tout : haussier, baissier. Pas de suivi de mitigation,
//  pas d'inversion (irFVG). Chaque zone est une boîte tirée à droite sur
//  « extension max » bougies, puis coupée net.
//
//  La détection est jugée sur la bougie SUIVANTE close (barstate.isconfirmed),
//  donc pas de repaint : une zone tracée ne disparaît jamais.
// =========================================================================
indicator("rFVG / aFVG", overlay = true, max_boxes_count = 500)

// ============================ INPUTS =====================================
grpDet   = "Détection"
mode     = input.string("Seuls les rFVG", "Motifs retenus", group = grpDet,
     options = ["Seuls les rFVG", "Toutes (aFVG)"],
     tooltip = "« Seuls les rFVG » : la bougie centrale doit être entièrement du côté opposé à son sens par rapport à la MM (baissière au-dessus, haussière en dessous). « Toutes (aFVG) » : on ne regarde pas la MM, tout motif de base compte — les rFVG en font partie.")
showBull = input.bool(true, "Motifs haussiers", group = grpDet,
     tooltip = "Bougie centrale haussière laissant un gap au-dessus.")
showBear = input.bool(true, "Motifs baissiers", group = grpDet,
     tooltip = "Bougie centrale baissière laissant un gap en dessous.")

maLen    = input.int(50, "MM simple — période", minval = 2, group = grpDet,
     tooltip = "Sert au tri rFVG / aFVG : la bougie centrale doit être ENTIÈREMENT d'un côté, son plus bas au-dessus de la MM (cas baissier) ou son plus haut en dessous (cas haussier). Elle ne touche jamais la moyenne. En mode « Toutes », la MM ne filtre plus rien mais sert encore à étiqueter les boîtes.")

sizeMode = input.string("Amplitude (haut-bas)", "Mesure de la taille", group = grpDet,
     options = ["Amplitude (haut-bas)", "Corps (|clôture-ouverture|)"],
     tooltip = "Ce qu'on compare à l'ATR : l'amplitude complète de la bougie centrale (mèches incluses), ou seulement son corps.")
atrLen   = input.int(14, "ATR — période", minval = 1, group = grpDet)
atrMult  = input.float(1.5, "Taille bougie centrale >= ATR x", minval = 0.0, step = 0.1, group = grpDet,
     tooltip = "Le « x » de « taille >= x × ATR ». Plus haut = déplacements plus violents, moins de signaux. 0 = filtre désactivé.")
minPts   = input.float(0.0, "Gap minimum (points, 0 = tous)", minval = 0.0, step = 0.1, group = grpDet,
     tooltip = "Ignore les gaps dont la hauteur est inférieure à ce nombre de points (unités de prix).")

grpView   = "Affichage"
extLen    = input.int(20, "Extension max (bougies)", minval = 1, group = grpView,
     tooltip = "La zone est tirée à droite sur ce nombre de bougies à partir de la bougie centrale, puis coupée net.")
showLabel = input.bool(true, "Label dans la boîte", group = grpView,
     tooltip = "Chaque boîte annonce ce qu'elle est : « rFVG » si la bougie centrale est entièrement du côté opposé de la MM, « aFVG » sinon.")
showMa    = input.bool(true, "Tracer la MM", group = grpView)
colBull   = input.color(color.new(#26A69A, 82), "Couleur haussière", group = grpView)
colBear   = input.color(color.new(#EF5350, 82), "Couleur baissière", group = grpView)
colMa     = input.color(color.new(color.gray, 40), "Couleur de la MM", group = grpView)

// ============================ CALCUL =====================================
// Indices : la bougie courante est la SUIVANTE du motif.
//   [2] = précédente     [1] = centrale (creuse le gap)     [0] = suivante
ma  = ta.sma(close, maLen)
atr = ta.atr(atrLen)

// Motif de base : bougie centrale directionnelle, et gap laissé béant entre la
// précédente et la suivante. Rien à voir avec la MM à ce stade.
//   baissier : centrale baissière, et plus_bas(précédente) > plus_haut(suivante)
//   haussier : centrale haussière, et plus_haut(précédente) < plus_bas(suivante)
baseBear = close[1] < open[1] and low[2]  > high
baseBull = close[1] > open[1] and high[2] < low

// Condition de RETOURNEMENT : la centrale est entièrement du côté opposé à son
// sens, sans toucher la MM. C'est elle, et elle seule, qui sépare rFVG de aFVG.
maBear = low[1]  > ma[1]
maBull = high[1] < ma[1]

onlyR  = mode == "Seuls les rFVG"
isBear = baseBear and (not onlyR or maBear)
isBull = baseBull and (not onlyR or maBull)

// Un motif qui respecte aussi la MM est un rFVG ; les autres ne sortent qu'en
// mode « Toutes » et sont des aFVG.
isR = isBear ? maBear : maBull
lbl = isR ? "rFVG" : "aFVG"

// Taille de la bougie centrale, comparée à l'ATR lu AVANT elle ([2]).
midSize = sizeMode == "Corps (|clôture-ouverture|)" ? math.abs(close[1] - open[1]) : high[1] - low[1]
sizeOk  = atrMult <= 0 or midSize >= atrMult * atr[2]

// Bornes de la zone : le gap lui-même.
top    = isBear ? low[2]  : low
bottom = isBear ? high    : high[2]
gapOk  = minPts <= 0 or top - bottom >= minPts

// ============================ VISUEL =====================================
plot(showMa ? ma : na, "MM", color = colMa)

// La boîte démarre sur la bougie CENTRALE (bar_index - 1) et court extLen
// bougies vers la droite. Tracée seulement sur bougie close : pas de repaint.
if barstate.isconfirmed and sizeOk and gapOk
    if showBear and isBear
        box.new(bar_index - 1, top, bar_index - 1 + extLen, bottom,
             border_color = na, bgcolor = colBear,
             text = showLabel ? lbl : "", text_color = color.new(color.white, 20),
             text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
        alert(lbl + " BAISSIER sur " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar)
    if showBull and isBull
        box.new(bar_index - 1, top, bar_index - 1 + extLen, bottom,
             border_color = na, bgcolor = colBull,
             text = showLabel ? lbl : "", text_color = color.new(color.white, 20),
             text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
        alert(lbl + " HAUSSIER sur " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar)
