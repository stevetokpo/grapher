//@version=6
// =========================================================================
//  STRATÉGIE : rFVG / aFVG — trading des zones de déséquilibre
//
//  Portage fidèle de lib/backtest/strategies/rfvgZone.js (plateforme Grapher).
//  La DÉTECTION est celle de pines/rFVG.pine, inchangée ; ce script y ajoute
//  l'entrée, les stops et le break-even.
//
//  LECTURE DU MOTIF — une bougie centrale large et directionnelle laisse un gap
//  béant entre la bougie qui la précède et celle qui la suit. En mode rFVG elle
//  est en plus à contre-courant de son côté de la MM (baissière entièrement
//  au-dessus, haussière entièrement en dessous). La zone est le gap lui-même :
//    • zone baissière → zone d'OFFRE, au-dessus du marché  → on VEND
//    • zone haussière → zone de DEMANDE, en dessous        → on ACHÈTE
//
//  ENTRÉE
//    • « Retest » (défaut) — on attend que le prix revienne toucher la zone. Le
//      niveau part du bord PROCHE (celui que le prix rencontre en premier) et
//      s'enfonce de `marge` × ATR dans la zone ; négatif = anticipation, avant
//      la zone. Il est borné au bord opposé : une marge plus large que la zone
//      revient à en attendre la traversée complète, jamais à rendre le
//      déclenchement inatteignable.
//    • « Immédiate » — entrée dès la bougie qui confirme la zone.
//
//  DEUX SUBTILITÉS, sans quoi le résultat ne veut rien dire :
//
//  1. Le motif a besoin de la bougie SUIVANTE pour exister : il n'est connu qu'à
//     la clôture de celle-ci. Or le bord proche de la zone EST l'extrême exact
//     de cette bougie de confirmation (bas de zone = plus_haut(suivante) en
//     baissier). Un retest naïf serait donc déclenché par la bougie qui vient de
//     créer la zone — touche triviale par égalité — et le mode « Retest » se
//     réduirait silencieusement au mode « Immédiate ». Une zone n'est donc
//     testable qu'à partir de la bougie D'APRÈS.
//
//  2. Une seule position à la fois, et TANT QU'UNE POSITION EST OUVERTE aucune
//     zone n'est armée ni testée — les motifs qui apparaissent pendant un trade
//     sont perdus. C'est le comportement exact du moteur de backtest de la
//     plateforme : le reproduire est la condition pour que les statistiques
//     TradingView soient comparables aux siennes.
//
//  SORTIES — SL et TP fixes, en points ou en multiples d'ATR, mesurés en
//  distance depuis le prix d'entrée RÉELLEMENT obtenu (et non depuis la clôture
//  du signal). Break-even optionnel, réglé en fraction du risque initial : quand
//  le prix a parcouru `BE` × R en notre faveur, le stop revient au prix d'entrée
//  exactement — sans décalage, un stop posé au-delà du prix courant serait un
//  stop du mauvais côté du marché.
//
//  POUR COMPARER AVEC LES CHIFFRES DE LA PLATEFORME
//    • Friction : le moteur déduit un spread fixe par trade. Ici, cela se règle
//      dans l'onglet Propriétés (Commission / Slippage), pas dans les inputs.
//    • Ordre de priorité intra-bougie : le moteur vérifie les stops minute par
//      minute et, à égalité dans la même minute, fait gagner le SL. TradingView
//      ne descend pas sous la bougie du graphe sauf si « Recalculer sur chaque
//      tick » est actif ; sur une bougie qui touche SL ET TP, il applique sa
//      propre hypothèse. Un écart de quelques trades sur ce point est normal.
//    • Les statistiques TradingView sont en devise, pas en R. Avec une quantité
//      fixe, le R d'un trade vaut profit / (SL initial en points).
// =========================================================================
strategy("rFVG / aFVG — stratégie", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,
     calc_on_order_fills   = false,
     calc_on_every_tick    = false,
     max_boxes_count       = 500,
     max_lines_count       = 500,
     commission_type       = strategy.commission.percent,
     commission_value      = 0)

// ============================ INPUTS =====================================
grpDet   = "Détection"
mode     = input.string("Seuls les rFVG", "Motifs retenus", group = grpDet,
     options = ["Seuls les rFVG", "Toutes (aFVG)"],
     tooltip = "« Seuls les rFVG » : la bougie centrale doit être entièrement du côté opposé à son sens par rapport à la MM. « Toutes (aFVG) » : on ne regarde pas la MM.")
dirMode  = input.string("Les deux", "Direction", group = grpDet,
     options = ["Les deux", "Haussiers seuls", "Baissiers seuls"])
maLen    = input.int(50, "MM simple — période", minval = 2, group = grpDet)
sizeMode = input.string("Amplitude (haut-bas)", "Mesure de la bougie centrale", group = grpDet,
     options = ["Amplitude (haut-bas)", "Corps (|clôture-ouverture|)"])
atrLen   = input.int(14, "ATR — période", minval = 1, group = grpDet,
     tooltip = "Sert au filtre de taille, à la marge d'entrée ET aux stops en mode ATR.")
atrMult  = input.float(1.5, "Taille bougie centrale >= ATR x", minval = 0.0, step = 0.1, group = grpDet,
     tooltip = "0 = filtre de taille désactivé.")
minPts   = input.float(0.0, "Gap minimum (points, 0 = tous)", minval = 0.0, step = 0.1, group = grpDet)

grpEnt   = "Entrée"
entryMode = input.string("Retest", "Déclenchement", group = grpEnt,
     options = ["Retest", "Immédiate"],
     tooltip = "Retest : on attend le retour du prix dans la zone. Immédiate : on entre dès la bougie qui confirme la zone.")
entryAtr = input.float(0.0, "Marge d'entrée (× ATR)", step = 0.05, minval = -2, maxval = 5, group = grpEnt,
     tooltip = "Retest uniquement. Positif = attendre plus profond DANS la zone. Négatif = anticiper, avant la zone. Bornée au bord opposé de la zone.")
maxWait  = input.int(20, "Durée de vie de la zone (bougies)", minval = 1, maxval = 500, group = grpEnt,
     tooltip = "Nombre de bougies pendant lesquelles la zone reste armée après sa confirmation.")

grpExit  = "Sorties"
stopMode = input.string("ATR", "Unité des stops", options = ["ATR", "Points"], group = grpExit)
slValue  = input.float(1.5, "Stop Loss (× ATR ou points)",   minval = 0.01, step = 0.1, group = grpExit)
tpValue  = input.float(3.0, "Take Profit (× ATR ou points)", minval = 0.01, step = 0.1, group = grpExit)
beTrigR  = input.float(0.0, "Break-even (× R initial, 0 = off)", minval = 0, maxval = 10, step = 0.1, group = grpExit,
     tooltip = "Quand le prix a parcouru ce multiple du risque initial en notre faveur, le stop revient AU PRIX D'ENTRÉE (aucun décalage).")

grpView  = "Affichage"
showZone = input.bool(true, "Dessiner les zones", group = grpView)
showTrig = input.bool(true, "Dessiner le niveau de déclenchement", group = grpView,
     tooltip = "Retest : le niveau que le prix doit toucher pour armer l'entrée.")
colBull  = input.color(color.new(#26A69A, 82), "Couleur haussière", group = grpView)
colBear  = input.color(color.new(#EF5350, 82), "Couleur baissière", group = grpView)

// ============================ DÉTECTION ==================================
// Indices : la bougie courante est la SUIVANTE du motif.
//   [2] = précédente     [1] = centrale (creuse le gap)     [0] = suivante
ma  = ta.sma(close, maLen)
atr = ta.atr(atrLen)

baseBear = close[1] < open[1] and low[2]  > high
baseBull = close[1] > open[1] and high[2] < low

maBear = low[1]  > ma[1]
maBull = high[1] < ma[1]

onlyR  = mode == "Seuls les rFVG"
isBear = baseBear and (not onlyR or maBear)
isBull = baseBull and (not onlyR or maBull)

// Filtre de direction
isBear := isBear and dirMode != "Haussiers seuls"
isBull := isBull and dirMode != "Baissiers seuls"

// Taille de la centrale, comparée à l'ATR lu AVANT elle ([2]) — sinon l'ATR
// contiendrait déjà la bougie à qualifier.
midSize = sizeMode == "Corps (|clôture-ouverture|)" ? math.abs(close[1] - open[1]) : high[1] - low[1]
sizeOk  = atrMult <= 0 or midSize >= atrMult * atr[2]

zTop    = isBear ? low[2] : low
zBottom = isBear ? high   : high[2]
gapOk   = minPts <= 0 or (zTop - zBottom) >= minPts

// Warm-up : tant que la MM ou l'ATR ne sont pas formés, aucun motif ne peut
// être qualifié — ni sa taille, ni sa position par rapport à la MM.
ready    = not na(ma[1]) and not na(atr) and not na(atr[2])
detected = ready and (isBear or isBull) and sizeOk and gapOk
lblTxt   = (isBear ? maBear : maBull) ? "rFVG" : "aFVG"

// ============================ ZONES ARMÉES ===============================
// Une zone vit dans ces tableaux parallèles jusqu'à son expiration ou sa
// consommation. `zFrom` interdit à la bougie de confirmation de tester sa
// propre zone (cf. subtilité 1 de l'en-tête).
var array<float> zTrig   = array.new_float()
var array<int>   zSide   = array.new_int()      // +1 haussière, -1 baissière
var array<int>   zFrom   = array.new_int()
var array<int>   zExpire = array.new_int()

// État du trade en cours
var float slDist = na       // distance entrée→SL, en points = risque initial (R)
var float tpDist = na
var bool  beDone = false

flat = strategy.position_size == 0

// ============================ VISUEL =====================================
if detected and showZone
    box.new(bar_index - 1, zTop, bar_index - 1 + maxWait, zBottom,
         border_color = na, bgcolor = isBear ? colBear : colBull,
         text = lblTxt, text_color = color.new(color.white, 25),
         text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)

// ============================ LOGIQUE ====================================
// Tant qu'une position est ouverte : break-even, et RIEN d'autre — aucune zone
// n'est armée, purgée ni testée (fidèle au moteur de la plateforme).
if not flat
    if beTrigR > 0 and not beDone and not na(slDist)
        avg = strategy.position_avg_price
        fav = strategy.position_size > 0 ? close - avg : avg - close
        if fav >= beTrigR * slDist
            beDone := true
            // Stop ramené au prix d'entrée EXACT ; le TP reste inchangé.
            strategy.exit("SL/TP", from_entry = "rFVG", stop = avg,
                 profit = tpDist / syminfo.mintick)
else
    // — Distances de stop, mesurées à la bougie de décision.
    slD = stopMode == "Points" ? slValue : slValue * atr
    tpD = stopMode == "Points" ? tpValue : tpValue * atr

    enterLong  = false
    enterShort = false

    if entryMode == "Immédiate"
        // La zone se joue dès sa confirmation : pas d'armement, pas d'attente.
        enterLong  := detected and isBull
        enterShort := detected and isBear
    else
        // — Armer la zone qui vient d'être confirmée.
        if detected
            margin = entryAtr * atr
            // Bord PROCHE = celui que le prix rencontre en revenant : le bas
            // d'une zone d'offre (le prix est dessous), le haut d'une zone de
            // demande. La marge enfonce le niveau dans la zone, bornée au bord
            // opposé — une marge plus large que la zone ne rend jamais le
            // déclenchement inatteignable.
            trig = isBear ? math.min(zBottom + margin, zTop) : math.max(zTop - margin, zBottom)
            array.push(zTrig,   trig)
            array.push(zSide,   isBear ? -1 : 1)
            array.push(zFrom,   bar_index + 1)
            array.push(zExpire, bar_index + maxWait)
            if showTrig
                line.new(bar_index, trig, bar_index + maxWait, trig,
                     color = isBear ? color.new(#EF5350, 35) : color.new(#26A69A, 35),
                     style = line.style_dotted, width = 1)

        // — Purger les zones périmées.
        if array.size(zTrig) > 0
            for i = array.size(zTrig) - 1 to 0
                if bar_index > array.get(zExpire, i)
                    array.remove(zTrig,   i)
                    array.remove(zSide,   i)
                    array.remove(zFrom,   i)
                    array.remove(zExpire, i)

        // — Premier toucher, zone la PLUS RÉCENTE d'abord. La zone touchée est
        //   consommée ; les autres restent armées jusqu'à leur expiration.
        if array.size(zTrig) > 0
            for i = array.size(zTrig) - 1 to 0
                if bar_index >= array.get(zFrom, i)
                    t   = array.get(zTrig, i)
                    bear = array.get(zSide, i) == -1
                    hit = bear ? high >= t : low <= t
                    if hit
                        if bear
                            enterShort := true
                        else
                            enterLong := true
                        array.remove(zTrig,   i)
                        array.remove(zSide,   i)
                        array.remove(zFrom,   i)
                        array.remove(zExpire, i)
                        break

    // — Ordre au marché : décision à la clôture, exécution à l'open suivant.
    //   Les stops sont posés en TICKS depuis le prix d'entrée réel (équivalent
    //   des slPoints / tpPoints du moteur), et sont donc actifs dès la bougie
    //   d'entrée — y compris en intra-bougie.
    if (enterLong or enterShort) and slD > 0
        slDist := slD
        tpDist := tpD
        beDone := false
        strategy.entry("rFVG", enterLong ? strategy.long : strategy.short)
        strategy.exit("SL/TP", from_entry = "rFVG",
             loss   = slD / syminfo.mintick,
             profit = tpD / syminfo.mintick)
