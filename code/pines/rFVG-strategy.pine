//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// rFVG — STRATÉGIE backtestable  (détection calcRFVG + positions SL/TP)
// Jumelle de l'indicateur pines/rFVG.pine : MÊME détection, MÊME règle d'entrée.
//
// DÉTECTION (portage fidèle de calcRFVG, lib/patterns.js) — motif 3 bougies :
//   centrale directionnelle + large (>= atrMult × ATR lu à central-1), gap entre
//   la précédente et la suivante ; rFVG = centrale entièrement à contre-courant
//   de son sens sans toucher NI la MM rapide (15) NI la MM lente (200). Modes
//   rfvg / all / super, direction, minPts, sizeMode — identiques à l'indicateur.
//   minPts est SIGNÉ : 0 = vrai vide exigé, négatif = la précédente et la suivante
//   peuvent se chevaucher, la zone devenant leur bande commune au lieu du vide.
//
// ENTRÉE (règle demandée, pilotée par la 3e bougie = celle qui referme le gap) :
//   • 3e À CONTRE-SENS du rFVG (cas super) → ENTRÉE MARCHÉ à l'ouverture de la
//     bougie suivante (strategy.entry sans limite → fill à l'open suivant).
//   • 3e DANS LE SENS du rFVG → ORDRE LIMITE au niveau d'OUVERTURE de la 3e ;
//     rempli au retour du prix (buy-limit : low<=niveau ; sell-limit : high>=niveau),
//     annulé s'il n'est pas rempli dans `expiry` bougies après la centrale.
//   • SL/TP en points de prix depuis l'entrée réelle ; BREAK-EVEN optionnel.
//
// ⚠️ DIFFÉRENCES avec la simulation de l'indicateur (inhérentes à une stratégie) :
//   1. UNE SEULE POSITION à la fois (pyramiding=0) : un signal qui survient alors
//      qu'un ordre/position est déjà actif est IGNORÉ. L'indicateur, lui, montre
//      chaque signal indépendamment (positions superposées possibles).
//   2. Conflit SL/TP dans la même bougie : le Strategy Tester applique son
//      heuristique « extrême le plus proche de l'open en premier », là où
//      l'indicateur suppose TOUJOURS le stop d'abord (pessimiste). Rare en pratique.
//   3. Break-even : le stop déplacé s'applique à partir de la bougie SUIVANT son
//      armement (granularité barre), pas intra-bougie comme dans l'indicateur.
//
// ⚠️ SL/TP EN UNITÉS DE PRIX, PAS EN PIPS NI EN % : 10.0 vaut 10 $ sur XAUUSD,
//    mais 1 000 000 de ticks sur EURUSD — un stop que le prix n'atteindra jamais.
//    Une position qui ne se referme pas gèle la stratégie entière (pyramiding=0) :
//    tout signal ultérieur est refusé et le rapport n'affiche qu'UN SEUL trade.
//    Le compteur en haut à droite (« Refusés (occupé) » / « Position ouverte »)
//    distingue ce cas d'un vrai manque de signaux.
//
// Anti-repaint : stratégie en calcul à la clôture (calc_on_every_tick=false),
// donc [0]=3e bougie close, [1]=centrale, [2]=précédente. Aucun repaint.
// Coûts (commission, slippage) et taille de position : à régler dans les
// propriétés de la stratégie.
// ─────────────────────────────────────────────────────────────────────────────
strategy("rFVG — stratégie (SL/TP)", "rFVG strat", overlay = true, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false, default_qty_type = strategy.fixed, default_qty_value = 1, max_boxes_count = 500, max_labels_count = 500)

// ── Détection (mêmes options que calcRFVG) ───────────────────────────────────
grpDet       = "Détection"
mode         = input.string("rfvg", "Motifs retenus", options = ["rfvg", "all", "super"], group = grpDet, tooltip = "rfvg : retournements seuls · all : tout · super : rFVG dont la 3e bougie referme le gap à contre-sens")
direction    = input.string("both", "Direction",       options = ["both", "bull", "bear"], group = grpDet)
maPeriodFast = input.int(15,  "MM rapide — période",   minval = 1, group = grpDet)
maPeriodSlow = input.int(200, "MM lente — période",    minval = 1, group = grpDet)
atrPeriod    = input.int(14,  "ATR — période",         minval = 0, group = grpDet)
atrMult      = input.float(1.5, "Taille centrale ≥ ATR ×", minval = 0, step = 0.1, group = grpDet, tooltip = "0 = filtre de taille désactivé")
sizeMode     = input.string("range", "Mesure de la taille", options = ["range", "body"], group = grpDet)
minPts       = input.float(0.0, "Gap minimum (prix, signé)", step = 0.1, group = grpDet, tooltip = "0 = vrai vide exigé entre la 1re et la 3e bougie · négatif = chevauchement toléré jusqu'à cette profondeur, la zone devient leur bande commune")

// ── Positions (SL / TP) ──────────────────────────────────────────────────────
grpPos     = "Positions (SL / TP)"
slPts      = input.float(10.0, "SL — distance (prix)",   minval = 0, step = 0.1, group = grpPos, tooltip = "Distance du stop depuis l'entrée, en unités de prix")
tpPts      = input.float(10.0, "TP — distance (prix)",   minval = 0, step = 0.1, group = grpPos, tooltip = "Distance de l'objectif depuis l'entrée, en unités de prix")
expiryBars = input.int(20,     "Expiration de l'ordre limite (bougies)", minval = 1, group = grpPos, tooltip = "L'ordre limite est annulé s'il n'est pas rempli dans ce nombre de bougies après la centrale")
beTrigger  = input.float(0.0,  "Break-even — seuil (prix, 0 = off)", minval = 0, step = 0.1, group = grpPos, tooltip = "Profit à partir duquel le stop est déplacé au niveau BE")
beLevel    = input.float(0.0,  "Break-even — niveau du stop (prix vs entrée)", step = 0.1, group = grpPos, tooltip = "0 = entrée exacte · positif = gain verrouillé · négatif = perte réduite")

// ── Affichage (zones, facultatif) ────────────────────────────────────────────
grpAff     = "Affichage"
showZone   = input.bool(true,  "Afficher les zones", group = grpAff)
extLen     = input.int(20, "Extension zone (bougies)", minval = 1, group = grpAff)
bullCol    = input.color(#26A69A, "Couleur haussière", group = grpAff)
bearCol    = input.color(#EF5350, "Couleur baissière", group = grpAff)
fillTransp = input.int(85, "Transparence du remplissage", minval = 0, maxval = 100, group = grpAff)
showDiag   = input.bool(true, "Compteur de signaux (pris / refusés)", group = grpAff, tooltip = "Un signal valide est REFUSÉ si une position ou un ordre limite est déjà actif. Si « refusés » explose, le blocage vient de la contrainte une-position-à-la-fois, pas de la détection.")

// ── Séries auxiliaires (alignées, comme smaArr / atrArr) ─────────────────────
maFast = ta.sma(close, maPeriodFast)
maSlow = ta.sma(close, maPeriodSlow)
useAtr = atrPeriod > 0 and atrMult > 0
atrVal = ta.atr(atrPeriod)

// ── Détection sur bougie close : centrale=[1], précédente=[2], suivante/3e=[0] ─
onlyR   = mode != "all"
avgFast = maFast[1]
avgSlow = maSlow[1]
atrRef  = atrVal[2]

maOk     = not na(avgFast) and not na(avgSlow)
baseBear = maOk and close[1] < open[1]
baseBull = maOk and close[1] > open[1]

maBear = low[1]  > avgFast and low[1]  > avgSlow
maBull = high[1] < avgFast and high[1] < avgSlow

// Filtre super (3e à contre-sens) + filtre direction, en une passe.
superBear = mode != "super" or close[0] > open[0]
superBull = mode != "super" or close[0] < open[0]
isBear = baseBear and (not onlyR or maBear) and superBear and direction != "bull"
isBull = baseBull and (not onlyR or maBull) and superBull and direction != "bear"
proceed = isBear or isBull

// Taille de la centrale vs ATR (lu à central-1) + gap minimum SIGNÉ. Le gap positif
// est un vide entre la 1re et la 3e bougie, le négatif un chevauchement : la zone
// est alors leur bande commune, mêmes bornes dans l'autre ordre. Gap nul rejeté.
hiLvl  = isBear ? low[2]  : low[0]
loLvl  = isBear ? high[0] : high[2]
gap    = hiLvl - loLvl
top    = gap > 0 ? hiLvl : loLvl
bottom = gap > 0 ? loLvl : hiLvl
gapOk   = gap != 0 and gap >= minPts
sizeVal = sizeMode == "body" ? math.abs(close[1] - open[1]) : high[1] - low[1]
atrOk   = not useAtr or (not na(atrRef) and sizeVal >= atrMult * atrRef)

signal = proceed and gapOk and atrOk

// Zone (facultatif) — mêmes boîtes que l'indicateur.
if signal and showZone
    centralIdx = bar_index - 1
    col = isBear ? bearCol : bullCol
    box.new(centralIdx, top, centralIdx + extLen, bottom, border_color = col, bgcolor = color.new(col, fillTransp), xloc = xloc.bar_index)

// ── Gestion des ordres / positions ───────────────────────────────────────────
var bool pending         = false   // ordre limite en attente de remplissage
var int  pendingDeadline = na      // barre au-delà de laquelle il est annulé
var bool beArmed         = false   // break-even armé sur la position en cours

// Diagnostic : un signal valide peut être parfaitement détecté ET refusé faute
// de disponibilité. Sans ces compteurs, le refus est silencieux et la stratégie
// a l'air de « rater » des motifs qu'elle a en réalité vus et écartés.
var int nSignals = 0
var int nTaken   = 0
var int nSkipped = 0

inPos  = strategy.position_size != 0
isLong = strategy.position_size > 0

// 1) Ordre limite en attente : rempli → on nettoie l'état ; expiré → annulé.
//    strategy.cancel ne touche PAS l'ordre de sortie associé : il resterait en
//    attente de l'entrée « rFVG » et se rattacherait au signal suivant avec ses
//    anciens niveaux. On purge donc tout tant qu'on est à plat.
if pending
    if inPos
        pending := false
    else if bar_index > pendingDeadline
        strategy.cancel_all()
        pending := false

// 2) SL/TP RÉ-ÉMIS À CHAQUE BOUGIE tant que la position est ouverte, calculés
//    depuis le prix d'entrée réel. Un strategy.exit posé une seule fois sur la
//    barre de signal (avant remplissage) peut ne jamais être honoré : la
//    position reste alors ouverte indéfiniment et, pyramiding=0 aidant, bloque
//    TOUS les signaux suivants — un seul trade sur tout l'historique.
//    Le break-even, quand il est armé, ne fait que déplacer ce même stop.
if inPos
    avg = strategy.position_avg_price
    if beTrigger > 0 and not beArmed
        fav = isLong ? high - avg : avg - low
        if fav >= beTrigger
            beArmed := true
    stopPx = beArmed ? (isLong ? avg + beLevel : avg - beLevel) : (isLong ? avg - slPts : avg + slPts)
    tpPx   = isLong ? avg + tpPts : avg - tpPts
    strategy.exit("rFVG-x", from_entry = "rFVG", stop = stopPx, limit = tpPx)
else
    beArmed := false

// 3) Nouveau signal : ouverture SEULEMENT si aucune position ni ordre en attente.
bool skippedSig = false
if signal and slPts > 0 and tpPts > 0
    nSignals += 1
    if not inPos and not pending
        nTaken += 1
        isBuy   = isBull
        // 3e bougie à contre-sens du rFVG → marché ; sinon → limite à l'open de la 3e.
        opp     = isBuy ? close[0] < open[0] : close[0] > open[0]
        slTicks = int(math.max(1, math.round(slPts / syminfo.mintick)))
        tpTicks = int(math.max(1, math.round(tpPts / syminfo.mintick)))
        strategy.entry("rFVG", isBuy ? strategy.long : strategy.short, limit = opp ? na : open[0])
        // Sortie en ticks posée avec l'entrée : elle est active DÈS la bougie de
        // remplissage (le bloc 2, lui, ne prend le relais qu'à la bougie d'après).
        strategy.exit("rFVG-x", from_entry = "rFVG", loss = slTicks, profit = tpTicks)
        if not opp
            pending         := true
            pendingDeadline := (bar_index - 1) + expiryBars   // centralIdx + expiry
    else
        nSkipped   += 1
        skippedSig := true

// Signaux refusés, visibles sur le graphique + bilan chiffré.
plotchar(skippedSig, "Signal refusé", "×", location.abovebar, color.new(color.gray, 20), size = size.tiny)

if showDiag and barstate.islast
    var table tDiag = table.new(position.top_right, 2, 4, border_width = 1)
    table.cell(tDiag, 0, 0, "Signaux détectés", text_size = size.small, text_halign = text.align_left)
    table.cell(tDiag, 1, 0, str.tostring(nSignals), text_size = size.small)
    table.cell(tDiag, 0, 1, "Ordres envoyés",   text_size = size.small, text_halign = text.align_left)
    table.cell(tDiag, 1, 1, str.tostring(nTaken), text_size = size.small)
    table.cell(tDiag, 0, 2, "Refusés (occupé)", text_size = size.small, text_halign = text.align_left)
    table.cell(tDiag, 1, 2, str.tostring(nSkipped), text_size = size.small, text_color = color.orange)
    table.cell(tDiag, 0, 3, "Position ouverte", text_size = size.small, text_halign = text.align_left)
    table.cell(tDiag, 1, 3, inPos ? "OUI" : "non", text_size = size.small, text_color = inPos ? color.red : color.gray)
